# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins in production (leave * for local dev)
ALLOWED_ORIGINS=*

# Neon Serverless Postgres Configuration
# Get this from Neon Dashboard or Vercel Storage -> Neon Postgres
DATABASE_URL=postgresql://user:password@ep-your-neon-host.neon.tech/neondb?sslmode=require
